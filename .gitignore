# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# opencode runtime data
.omo/

# opencode project config (contains MCP server config)
.opencode.json

# media assets — too large / personal, deploy separately
public/videos/
public/photos/
public/images/
public/uploads/

# raw source materials (duplicate of public/)
素材/

# next.js default placeholders (not used)
public/file.svg
public/globe.svg
public/next.svg
public/vercel.svg
public/window.svg
